Node slow = head;
Node fast = head;

while (fast != null && fast.next != null) {
    slow = slow.next;
    fast = fast.next.next;
}

return slow;

//Linked List ka middle find karna
// Logic
// slow → 1 step
// fast → 2 steps
// Jab fast end par pahunchta hai, slow middle node par hota hai.

// Time: O(n)
// Space: O(1)
